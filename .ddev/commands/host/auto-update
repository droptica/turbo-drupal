#!/usr/bin/env bash

## Description: Run security updates via composer, drush updb/cex, then commit and push to a new update/* branch.
## Usage: auto-update [--dry-run|-n] [--no-commit] [--branch|-b <name>] [site ...]
## Example: "ddev auto-update", "ddev auto-update --dry-run" or "ddev auto-update -b feature/PROJ-123-security-updates --no-commit"

# Disable commands dynamic path.
# shellcheck disable=SC2154

# Prepare some colors.
red=$(tput -T xterm-256color setaf 1)
aqua=$(tput -T xterm-256color setaf 14)
lime=$(tput -T xterm-256color setaf 10)
yellow=$(tput -T xterm-256color setaf 11)
no_color=$(tput -T xterm-256color sgr0)

# Move user to global dir for proper functionality.
cd "${DDEV_APPROOT}" || exit

# Declare composer update function.
composer_update() {
  # Print debug command
  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev composer update $1${no_color}"

  # Run ddev composer update on all available updates.
  # In dry-run mode show composer output, since it is the only result of the run.
  if [[ ${dry_run} == true ]]; then
    ddev composer update $1 2>&1 | tee composer_update_result.txt
  else
    (ddev composer update $1 | tee composer_update_result.txt) > /dev/null 2>&1
  fi

  # Get update result.
  composer_update_result=$(cat composer_update_result.txt) && rm composer_update_result.txt

  # Check if we see problem string inside our logs.
  if [[ ${composer_update_result} == *"Problem"* ]]; then
    # Print message about errors.
    echo "${aqua}[Auto update] ${red}Composer update failed due to dependencies problems. Fix all listed problems and try again.${no_color}"
    exit
  fi

  # Check if we see permission denied string inside our logs.
  if [[ ${composer_update_result} == *"Permission denied (publickey)"* ]]; then
    # Print message about errors.
    echo "${aqua}[Auto update] ${red}Composer update failed due to permission denied. Fix all listed problems and try again.${no_color}"
    exit
  fi
}

# Declare git commit function
commit_changes() {
  # Print debug command.
  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}git status${no_color}"

  # Check if composer.lock was changed and grab full path to it from git status output.
  git status | tee git_status_result.txt > /dev/null 2>&1
  git_status_result=$(cat git_status_result.txt) && rm git_status_result.txt

  # Check if we have changes inside composer.lock
  if [[ ${git_status_result} =~ ([ ]+)(([a-zA-Z0-9_ \/\.\-]+\/)*composer\.lock) ]]; then
    # Get lock file changes for variables.
    composer_lock_file=${BASH_REMATCH[2]}
    date=$(date '+%Y-%m-%d_%H-%M-%S')
    update_branch_name="${branch_name:-update/${date}}"
    commit_message="${DDEV_SITENAME^}: Update ${date}"

    # Try to run extra commands after update.
  for site in "$@"; do
      # Print debug command.
      echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev drush updb -y -l \"${site}\"${no_color}"

      # Run database update on current site.
      (ddev drush updb -y -l "${site}" 2>&1 | tee drush_update_db_result.txt) > /dev/null 2>&1
      drush_update_db_result=$(cat drush_update_db_result.txt)

      # Check if we have success.
      if
        [[ ${drush_update_db_result} != *"[success] No pending updates."* ]] &&
        [[ ${drush_update_db_result} != *"[success] Finished performing updates."* ]] &&
        [ "${#drush_update_db_result}" -gt 0 ]
      then
        # If not print that and quit.
        echo "${aqua}[Auto update] ${red}Database updates failed.${no_color}"
        exit 1;
      fi

      # Remove logs from drush update db.
      rm drush_update_db_result.txt

      # Print debug command.
      echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev drush cr -y -l \"${site}\"${no_color}"

      # Final step, clear cache.
      ddev drush cr -y -l "${site}" > /dev/null 2>&1

      # Print debug command.
      echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev drush cex -y -l \"${site}\"${no_color}"

      # Final step, clear cache.
      ddev drush cex -y -l "${site}" > /dev/null 2>&1
    done

    # Print debug command.
    echo "${aqua}[Auto update] ${no_color}Running: ${yellow}git checkout \"${update_branch_name}\" && git add${no_color}"

    # Switch to existing branch instead of -B, which would reset it and drop task commits.
    if git show-ref --verify --quiet "refs/heads/${update_branch_name}"; then
      checkout_args=("${update_branch_name}")
    else
      checkout_args=(-b "${update_branch_name}")
    fi
    if ! git checkout "${checkout_args[@]}" > /dev/null 2>&1; then
      echo "${aqua}[Auto update] ${red}Could not switch to branch \"${update_branch_name}\". Changes left uncommitted on current branch.${no_color}"
      exit 1
    fi

    # Stage updated files.
    git add "*.yml" > /dev/null 2>&1
    git add "composer.json" > /dev/null 2>&1
    git add "${composer_lock_file}" > /dev/null 2>&1

    # Leave staged changes for manual review - push without a commit would be pointless.
    if [[ ${no_commit} == true ]]; then
      echo "${aqua}[Auto update] ${lime}Auto update finished. Changes staged on branch \"${update_branch_name}\", commit and push skipped.${no_color}"
      echo "${aqua}[Auto update] ${no_color}Proposed commit message: ${yellow}${commit_message}${no_color}"
      echo "${aqua}[Auto update] ${no_color}To commit and push run:"
      echo "  git commit -m \"${commit_message}\" && git push --set-upstream origin \"${update_branch_name}\""
      return
    fi

    # Print debug command.
    echo "${aqua}[Auto update] ${no_color}Running: ${yellow}git commit${no_color}"

    git commit -m "${commit_message}" > /dev/null 2>&1
    changes_committed=true

    # Print success message.
    echo "${aqua}[Auto update] ${lime}Auto update finished successfully.${no_color}"
  else
    # If we do not have any changes inside composer.lock print message.
    echo "${aqua}[Auto update] ${red}Branch not created, because composer.lock file was not modified.${no_color}"
  fi
}

# Declare git push function.
push_changes() {
  # Nothing to push when composer.lock was unchanged or --no-commit was used.
  if [[ ${changes_committed} != true ]]; then
    return
  fi

  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}git push --set-upstream origin "${update_branch_name}"${no_color}"
  git push --set-upstream origin "${update_branch_name}"
}

# Declare function to checkout default origin branch.
checkout_default_origin_branch() {
  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}git fetch${no_color}"
  git fetch origin > /dev/null 2>&1

  default_branch=$(git remote show origin | grep 'HEAD branch' | awk '{print $NF}')

  if [ -z "$default_branch" ]; then
    echo "${red}[Error] ${no_color}Could not determine the default branch name.${no_color}"
    return 1
  fi

  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}git checkout ${default_branch}${no_color}"
  git checkout $default_branch > /dev/null 2>&1

  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}git pull origin ${default_branch}${no_color}"
  git pull origin $default_branch > /dev/null 2>&1

  echo "${aqua}[Auto update] ${no_color}Successfully checked out and pulled latest code for ${default_branch}.${no_color}"
}

# Declare run ddev build.
ddev_build() {
  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev start${no_color}"
  ddev start > /dev/null 2>&1
  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev download-data${no_color}"
  ddev download-data > /dev/null 2>&1
  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev db-restore${no_color}"
  ddev  db-restore > /dev/null 2>&1
  for site in "$@"; do
    echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev drush config:export -y -l \"${site}\" ${no_color}"
    ddev drush config:export -y -l "${site}" > /dev/null 2>&1
  done
  echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev build${no_color}"
  ddev build > /dev/null 2>&1
}

# Declare function to run tests.
run_tests() {
  if [[ -f ".ddev/commands/web/tests" ]]; then
    echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev tests${no_color}"
    ddev tests > tests_result.txt 2>&1
    test_result=$(cat tests_result.txt) && rm tests_result.txt
    if [[ ${test_result} == *"ERRORS!"* ]]; then
      echo "${aqua}[Auto update] ${red}Tests failed. Aborting config export.${no_color}"
      exit 1
    fi
    echo "${aqua}[Auto update] ${lime}Tests passed successfully.${no_color}"
  else
    echo "${aqua}[Auto update] ${yellow}No test script found. Skipping tests.${no_color}"
  fi
}

# Declare function to export configuration.
export_config() {
  # Loop through each given site.
  for site in "$@"; do
    # Print what we are doing on which site.
    echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev drush config:export -y -l \"${site}\" --commit --message=\"${DDEV_SITENAME^}: Config export\"${no_color}"
    ddev drush config:export -y -l "${site}" --commit --message="${DDEV_SITENAME^}: Config export" > /dev/null 2>&1
  done
}

# Declare platform function.
platform_environment() {
  CONFIG_FILE=".ddev/config.yaml"
  echo "${aqua}[Auto update] ${no_color}Checking if is platform environment"

  if grep -q "PLATFORM_PROJECT=" "$CONFIG_FILE"; then
      echo "${aqua}[Auto update] ${yellow}PLATFORM_PROJECT ${no_color}env exists in config"

      attempt=0
      while [[ $attempt -lt 3 ]]; do
          echo "${aqua}[Auto update] ${no_color}Running: ${yellow}platform environment:list${no_color}"
          env_list=$(platform environment:list)

          if echo "$env_list" | grep -q "${update_branch_name}"; then
              echo "${aqua}[Auto update] ${no_color}Found ${yellow}${update_branch_name}${no_color} in environment list"
              echo "${aqua}[Auto update] ${no_color}Running: ${yellow}platform environment:activate --environment ${update_branch_name}${no_color}"
              platform environment:activate --environment "${update_branch_name}"
              break
          else
              attempt=$((attempt + 1))
              echo "${aqua}[Auto update] ${yellow}${update_branch_name}${no_color} not found in environment list. Attempt $attempt of 3."
              if [[ $attempt -eq 3 ]]; then
                  echo "${aqua}[Auto update] ${no_color}${yellow}Failed to find ${update_branch_name} after 3 attempts, skipping activation.${no_color}"
              fi
          fi
      done
  else
      echo "${aqua}[Auto update] ${yellow}PLATFORM_PROJECT ${no_color}env doesn't exist in config, skipping"
  fi
}

# Declare auto update function.
auto_update() {
  # Prepare declaration.
  declare -A packages_to_update=()

  # Prepare some variables.
  app_path="web"
  updates_check_script_path=".ddev/commands/host/auto_update/updates_check.php"

  # Check if target script does actually exists.
  if [[ ! -f ${updates_check_script_path} ]]; then
    # If not print proper message.
    echo "${aqua}[Auto update] ${red}Updates check failed. File 'updates_check.php' not found.${no_color}"
    exit 1;
  fi

  # Loop through each given site.
  for site in "$@"; do
    # Print what we are doing on which site.
    echo "${aqua}[Auto update] ${no_color}Running auto-update on site \"${yellow}${site}${no_color}\"."
    echo "${aqua}[Auto update] ${no_color}Enabling update module on target site..."
    echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev drush en update -y -l \"${site}\"${no_color}"

    # Enable update module.
    ddev drush en update -y -l "${site}" > /dev/null 2>&1

    # Print what we gonna do.
    echo "${aqua}[Auto update] ${no_color}Clearing cache after enabling module..."
    echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev drush cr -y -l \"${site}\"${no_color}"

    # Clear cache after those actions
    ddev drush cr -y -l "${site}" > /dev/null 2>&1

    # Print what we gonna do.
    echo "${aqua}[Auto update] ${no_color}Gather info about packages that need to be updated..."
    echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev php \"${updates_check_script_path}\" \"${site}\" \"${app_path}\"${no_color}"

    # Run update test on given site.
    updates_check_result=$(ddev php "${updates_check_script_path}" "${site}" "${app_path}" | tail -n1)

    # Check if results does actually contain anything.
    if [[ ${updates_check_result} =~ (<<)(.*)(>>) ]]; then
      # Get our packages which need to be updates.
      if [[ -n ${BASH_REMATCH[2]} ]]; then
        # Loop through each package to update.
        for package in ${BASH_REMATCH[2]}; do
          # Save that package to array.
          packages_to_update[${package}]=${package}
        done
      fi
    else
      # In case of any other case, print error.
      echo "${aqua}[Auto update] ${red}Updates check failed. Reason: ${no_color}${updates_check_result}"
      exit 1;
    fi
  done

  # Check if we successfully get some requirements.
  if [[ -n "${packages_to_update[*]}" ]]; then
    # Print them.
    echo "${aqua}[Auto update] ${no_color}Required update for following packages: ${lime}${packages_to_update[*]}${no_color}"

    # If drupal/core needs to be updated, we need to check if drupal/core-recommended is used.
    if [[ "${packages_to_update[*]}" == *"drupal/core"* ]]; then
      # Print debug command.
      echo "${aqua}[Auto update] ${no_color}Running: ${yellow}ddev composer show drupal/core-recommended${no_color}"

      # Show all core-recommended packages.
      ddev composer show drupal/core-recommended | tee drupal_core_recommended.txt > /dev/null 2>&1

      # Save them to variable.
      drupal_core_recommended=$(cat drupal_core_recommended.txt) && rm drupal_core_recommended.txt

      # Check if core-recommend was found.
      if [[ ${drupal_core_recommended} != *"Package drupal/core-recommended not found"* ]]; then
        # If so then run all core-* updates.
        composer_update "drupal/core-* --with-all-dependencies --no-interaction --no-dev${composer_dry_run_flag}"

        # Remove drupal/core from the list, since the update for it was already executed.
        unset packages_to_update["drupal/core"]
      fi
    fi

    # Update all other packages for which update is needed.
    if [[ -n "${packages_to_update[*]}" ]]; then
      # Run the same command as for drupal/core.
      composer_update "${packages_to_update[*]} --with-dependencies --no-interaction${composer_dry_run_flag}"
    fi

    # Dry run stops here - no tests, drush updb/cex, branch, commit or push.
    if [[ ${dry_run} == true ]]; then
      echo "${aqua}[Auto update] ${lime}Dry run finished. No changes were made to composer files, database, config or git.${no_color}"
      return
    fi

    run_tests
    commit_changes "$@"
    push_changes
#    platform_environment
  else
    # Print proper message if we do not have security updates.
    echo "${aqua}[Auto update] ${lime}No security updates available.${no_color}"
  fi
}

# Parse flags, everything else is treated as a site name.
dry_run=false
no_commit=false
changes_committed=false
branch_name=""
composer_dry_run_flag=""
sites_to_update=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run|-n)
      dry_run=true
      composer_dry_run_flag=" --dry-run"
      ;;
    --no-commit)
      no_commit=true
      ;;
    --branch=*)
      branch_name=${1#*=}
      ;;
    --branch|-b)
      if [[ -z $2 || $2 == -* ]]; then
        echo "${aqua}[Auto update] ${red}Option $1 requires a branch name.${no_color}"
        exit 1
      fi
      branch_name=$2
      shift
      ;;
    *)
      sites_to_update="${sites_to_update:+${sites_to_update} }$1"
      ;;
  esac
  shift
done

# Fail early on invalid branch name, before composer/drush make any changes.
if [[ -n ${branch_name} ]] && ! git check-ref-format --branch "${branch_name}" > /dev/null 2>&1; then
  echo "${aqua}[Auto update] ${red}Invalid branch name: \"${branch_name}\".${no_color}"
  exit 1
fi

# Check if we actually have any site.
if [[ -z ${sites_to_update+x} || -z ${sites_to_update} ]]; then
  # If not make default one as required.
  sites_to_update="default"
fi

# Print proper message if we do not have security updates.
echo "${aqua}[Auto update] ${lime}Running auto-update${no_color} script on those sites: ${yellow}${sites_to_update}${no_color}."

if [[ ${dry_run} == true ]]; then
  echo "${aqua}[Auto update] ${yellow}Dry run mode: composer update --dry-run only, branch checkout, ddev build and git steps are skipped.${no_color}"
fi
if [[ -n ${branch_name} && ${dry_run} != true ]]; then
  echo "${aqua}[Auto update] ${yellow}Target branch: ${branch_name}${no_color}"
fi
if [[ ${no_commit} == true && ${dry_run} != true ]]; then
  echo "${aqua}[Auto update] ${yellow}No-commit mode: changes will be staged only, commit and push are skipped.${no_color}"
fi

# Dry run works on current code and DB - no default branch checkout, data download or DB restore.
if [[ ${dry_run} != true ]]; then
  checkout_default_origin_branch
  ddev_build ${sites_to_update}
fi

# Run auto_update function with all given sites.
auto_update ${sites_to_update}
